# EXEMPLO SEM SEGREDOS. Copie para .env SOMENTE no ambiente privado de teste.
# Nunca publique .env, chaves, tokens ou dados .local na Biblioteca ou no Git.
# Todos os serviços começam desativados; preencher uma chave não basta para ativar.
PORT=4173
# Ollama local: instale Ollama, baixe um modelo e deixe o serviço aberto.
# Modelo padrão recomendado para notebooks com GPU de 8 GB: Qwen3.5 4B.
MODEL_PROVIDER=local
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=qwen3.5:4b
MODEL_API_KEY=
VEYRO_CHAT_ENABLED=true
MODEL_VISION_ENABLED=false
MODEL_TOOL_CALLS=true
# Opcional: endpoint remoto RunPod compatível com Chat Completions (somente HTTPS).
# Configure no .env privado do backend, nunca no frontend/GitHub.
# Não inclua token/chave na URL, nem use parâmetros ?token=...
# MODEL_PROVIDER=runpod
# MODEL_BASE_URL=https://<seu-endpoint-https>/v1
# MODEL_NAME=<identificador-do-modelo>
# MODEL_API_KEY=<chave-nova-no-ambiente-do-backend>
# Gerador local ComfyUI + checkpoint SDXL-Lightning (habilite depois de instalar os arquivos)
VEYRO_IMAGES_ENABLED=false
IMAGE_PROVIDER=comfyui-local
IMAGE_BASE_URL=http://127.0.0.1:8188
IMAGE_MODEL=sdxl_lightning_4step.safetensors
# Speech-to-text local (service bind is fixed to 127.0.0.1)
SPEECH_BASE_URL=http://127.0.0.1:8765
SPEECH_TOKEN=
WHISPER_MODEL=small
# Texto para fala. Azure é opcional; Pocket TTS roda localmente sem chave.
TTS_PROVIDER=azure
AZURE_SPEECH_REGION=
AZURE_SPEECH_KEY=
# Para usar Pocket TTS local: TTS_PROVIDER=pocket
POCKET_TTS_BASE_URL=http://127.0.0.1:8000
# Títulos, resumos e detector adicional de pesquisa
VEYRO_KNOWLEDGE_ENABLED=false
# Busca semântica
VEYRO_EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Pesquisa web local (serviços em Docker, limitados a 127.0.0.1)
VEYRO_WEB_ENABLED=false
SEARCH_BASE_URL=http://127.0.0.1:8081
SEARCH_API_KEY=
WEB_READER_URL=http://127.0.0.1:8082/read
WEB_READER_KEY=
# Gerados automaticamente por npm run setup; usados pelos containers locais
SEARXNG_SECRET=
# Equipe opcional CrewAI, usando o mesmo Qwen local via Ollama (sem API externa)
VEYRO_AGENTS_ENABLED=false
AGENT_BASE_URL=http://127.0.0.1:8766
AGENT_TOKEN=
AGENT_PORT=8766
OLLAMA_BASE_URL=http://127.0.0.1:11434
# No container do leitor (não no Worker), usar o mesmo segredo WEB_READER_KEY:
READER_KEY=
READER_RENDER_JS=false
# DB e BUCKET são bindings em produção; o teste local cria seus equivalentes.
